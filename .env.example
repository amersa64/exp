# Copy this file to `.env` and fill in the values you want.
# `.env` is gitignored — it never leaves your machine.
#
# The backend auto-loads `.env` on startup (see backend/api/app.py).
# After editing, restart the backend:
#   ./deploy.sh --restart-backend

# ============================================================================
# REQUIRED for real coach voice — without this the LLM falls back to a
# deterministic stub. The stub keeps the loop runnable offline, but every
# nudge / journal entry / coach reply will be canned instead of conditioned
# on your actual history. The whole point of the journal + LLM-authored
# nudge work is gated on this key.
# ============================================================================
ANTHROPIC_API_KEY=

# ============================================================================
# OPTIONAL — override the default Anthropic model. Leave blank to use the
# default. Examples: claude-haiku-4-5 (cheaper), claude-sonnet-4-5 (default
# quality), claude-opus-4-1 (slow but smartest).
# ============================================================================
COACH_LLM_MODEL=

# ============================================================================
# OPTIONAL — where to put the SQLite brain. Default is `coach.db` in CWD.
# ============================================================================
COACH_DB=
