# Copy this file to `.env` and fill in the values you want.
# `.env` is gitignored — it never leaves your machine.
#
# The backend auto-loads `.env` on startup (see backend/api/app.py).
# After editing, restart the backend:
#   ./deploy.sh --restart-backend
# or
#   ./deploy.sh --backend-only --restart-backend

# ============================================================================
# LLM PROVIDER — set EITHER ANTHROPIC_API_KEY or OPENAI_API_KEY (or both).
# Without one of these the system falls back to a deterministic stub:
# the coaching loop still runs end-to-end, but every nudge / journal entry
# / coach reply is canned instead of conditioned on your real history.
# ============================================================================

# Anthropic — keys look like sk-ant-...
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — keys look like sk-... or sk-proj-...
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL — pin a specific provider when both keys are present.
# Values: anthropic | openai. Leave blank to auto-detect (Anthropic wins
# ties because the prompts in this repo were tuned against Claude).
COACH_LLM_PROVIDER=

# OPTIONAL — override the model name. Provider defaults apply when blank.
#   Anthropic default: claude-sonnet-4-6
#   OpenAI default:    gpt-4o-mini
# Examples: claude-haiku-4-5, claude-opus-4-1, gpt-4o, gpt-5, o1
COACH_LLM_MODEL=

# ============================================================================
# OPTIONAL — where to put the SQLite brain. Default is `coach.db` in CWD.
# Ignored when SUPABASE_DB_URL is set (Postgres wins).
# ============================================================================
COACH_DB=

# ============================================================================
# PERSISTENCE BACKEND — leave blank for local SQLite (default; used by tests
# and local dev). Set SUPABASE_DB_URL to run the brain on Supabase/Postgres
# instead — this is the single switch that moves prod off SQLite.
#
# Use Supabase's TRANSACTION POOLER string (port 6543) — it survives
# scale-to-zero cold starts. Project Settings -> Database -> Connection string
# -> Transaction pooler:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# ============================================================================
SUPABASE_DB_URL=

# Service-role key (Project Settings -> API). NOT used by the DB connection;
# kept here for Supabase Edge Functions / pg_cron if you script against the API.
SUPABASE_SERVICE_KEY=

# ============================================================================
# API AUTH — leave blank for an OPEN API (local dev + tests). Set a strong
# random token to require `Authorization: Bearer <token>` on every route
# except /healthz. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# The iOS client and the pg_cron job that hits /scheduler/tick must send it.
# REQUIRED before exposing the backend publicly.
# ============================================================================
COACH_API_TOKEN=

# /dev/* routes (seed/wipe/tick) are destructive. Auto-disabled whenever
# COACH_API_TOKEN is set. Set to 1 to force them back on (still token-gated).
COACH_ENABLE_DEV=

# ============================================================================
# APNs PUSH — leave blank to disable push (server logs nudges instead, the
# LoggingPushDelivery default; fine for local/sim). Set all four to deliver
# real push to a closed phone. Create the key at developer.apple.com ->
# Certificates, Identifiers & Profiles -> Keys -> (+) -> Apple Push
# Notifications service (APNs). Download the AuthKey_XXXX.p8 ONCE.
# ============================================================================
# Either paste the .p8 contents inline (escape newlines as needed for your
# platform's secret store) OR point APNS_KEY_P8_FILE at the file on disk.
APNS_KEY_P8=
APNS_KEY_P8_FILE=
APNS_KEY_ID=          # the 10-char Key ID shown next to the key
APNS_TEAM_ID=7QF5D7PJL5
APNS_TOPIC=ai.zaimler.TheCoach   # the app bundle id
# true = APNs sandbox (matches a development-signed build). Set false for
# TestFlight/App Store builds (aps-environment: production).
APNS_SANDBOX=true


RAPID_API_KEY=