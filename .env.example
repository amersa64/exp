# Copy this file to `.env` and fill in the values you want.
# `.env` is gitignored — it never leaves your machine.
#
# The backend auto-loads `.env` on startup (see backend/api/app.py).
# After editing, restart the backend:
#   ./deploy.sh --restart-backend
# or
#   ./deploy.sh --backend-only --restart-backend

# ============================================================================
# LLM PROVIDER — set EITHER ANTHROPIC_API_KEY or OPENAI_API_KEY (or both).
# Without one of these the system falls back to a deterministic stub:
# the coaching loop still runs end-to-end, but every nudge / journal entry
# / coach reply is canned instead of conditioned on your real history.
# ============================================================================

# Anthropic — keys look like sk-ant-...
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — keys look like sk-... or sk-proj-...
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL — pin a specific provider when both keys are present.
# Values: anthropic | openai. Leave blank to auto-detect (Anthropic wins
# ties because the prompts in this repo were tuned against Claude).
COACH_LLM_PROVIDER=

# OPTIONAL — override the model name. Provider defaults apply when blank.
#   Anthropic default: claude-sonnet-4-6
#   OpenAI default:    gpt-4o-mini
# Examples: claude-haiku-4-5, claude-opus-4-1, gpt-4o, gpt-5, o1
COACH_LLM_MODEL=

# ============================================================================
# OPTIONAL — where to put the SQLite brain. Default is `coach.db` in CWD.
# ============================================================================
COACH_DB=
